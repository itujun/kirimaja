<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Payment Required</title>
    </head>
    <body style='margin:0; padding:0; background-color:#f4f4f5;'>
        <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background-color:#f4f4f5;'>
            <tr>
                <td align='center' style='padding:24px 16px;'>
                    <table role='presentation' width='600' cellpadding='0' cellspacing='0' style='max-width:600px; width:100%; background-color:#ffffff;'>

                        <!-- Brand header -->
                        <tr>
                            <td align='center' style='padding:0 20px 30px;'>
                                <h1 style='margin:0; color:#333333; font-family:Arial, sans-serif; font-size:24px;'>Kirim Aja</h1>
                                <p style='margin:5px 0 0; color:#666666; font-family:Arial, sans-serif; font-size:14px;'>Reliable Shipping Service</p>
                            </td>
                        </tr>

                        <!-- Title + intro -->
                        <tr>
                            <td style='padding:0 20px 20px; font-family:Arial, sans-serif;'>
                                <h2 style='margin:0 0 16px; color:#333333; font-size:20px;'>Payment Required</h2>
                                <p style='margin:0 0 16px; font-size:14px; color:#333333; line-height:1.6;'>Dear Customer,</p>
                                <p style='margin:0; font-size:14px; color:#333333; line-height:1.6;'>Thank you for using our shipping service. A payment is required for your shipment.</p>
                            </td>
                        </tr>

                        <!-- Shipment details box -->
                        <tr>
                            <td style='padding:0 20px 20px;'>
                                <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background-color:#f5f5f5; border-left:4px solid #007bff;'>
                                    <tr>
                                        <td style='padding:20px; font-family:Arial, sans-serif;'>
                                            <h3 style='margin:0 0 15px; color:#333333; font-size:16px;'>Shipment Details:</h3>
                                            <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;'>
                                                <tr>
                                                    <td style='padding:5px 0; color:#666666;'><strong>Shipment ID:</strong></td>
                                                    <td style='padding:5px 0; color:#333333;'>#{{shipmentId}}</td>
                                                </tr>
                                                <tr>
                                                    <td style='padding:5px 0; color:#666666;'><strong>Amount:</strong></td>
                                                    <td style='padding:5px 0; color:#333333;'>Rp {{amount}}</td>
                                                </tr>
                                                <tr>
                                                    <td style='padding:5px 0; color:#666666;'><strong>Payment Due Date:</strong></td>
                                                    <td style='padding:5px 0; color:#333333;'>{{expiryDate}}</td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Instruction -->
                        <tr>
                            <td style='padding:0 20px 10px; font-family:Arial, sans-serif; font-size:14px; color:#333333;'>
                                <p style='margin:0;'>Please click the button below to complete your payment:</p>
                            </td>
                        </tr>

                        <!-- CTA button (bulletproof pattern) -->
                        <tr>
                            <td align='center' style='padding:10px 20px 30px;'>
                                <table role='presentation' cellpadding='0' cellspacing='0'>
                                    <tr>
                                        <td style='border-radius:8px; background-color:#007bff;'>
                                            <a href='{{paymentUrl}}' style='display:inline-block; padding:15px 30px; font-family:Arial, sans-serif; font-size:14px; font-weight:bold; color:#ffffff; text-decoration:none;'>Pay Now</a>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Alternative link box -->
                        <tr>
                            <td style='padding:0 20px 20px;'>
                                <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background-color:#f8f9fa;'>
                                    <tr>
                                        <td style='padding:15px; font-family:Arial, sans-serif;'>
                                            <p style='margin:0; color:#666666; font-size:14px;'>
                                                <strong>Alternative:</strong> If the button doesn't work, copy and paste this link into your browser:
                                            </p>
                                            <p style='margin:10px 0 0;'>
                                                <a href='{{paymentUrl}}' style='color:#007bff; font-size:14px; word-break:break-all;'>{{paymentUrl}}</a>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Divider -->
                        <tr>
                            <td style='padding:0 20px;'>
                                <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
                                    <tr>
                                        <td style='border-top:1px solid #eeeeee; font-size:0; line-height:0;'>&nbsp;</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Contact note -->
                        <tr>
                            <td style='padding:20px 20px 0; font-family:Arial, sans-serif; font-size:14px; color:#666666;'>
                                <p style='margin:0;'>If you have any questions, please don't hesitate to contact our customer support.</p>
                            </td>
                        </tr>

                        <!-- Signature -->
                        <tr>
                            <td style='padding:20px 20px 0;'>
                                <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
                                    <tr>
                                        <td style='border-top:1px solid #eeeeee; padding-top:20px; font-family:Arial, sans-serif; font-size:14px;'>
                                            <p style='margin:0; color:#333333;'>Best regards,</p>
                                            <p style='margin:5px 0 0; color:#007bff; font-weight:bold;'>Kirim Aja Team</p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Automated disclaimer -->
                        <tr>
                            <td style='padding:20px;' align='center'>
                                <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
                                    <tr>
                                        <td style='border-top:1px solid #eeeeee; padding-top:20px; text-align:center; font-family:Arial, sans-serif;'>
                                            <p style='margin:0; color:#999999; font-size:12px;'>This is an automated message. Please do not reply to this email.</p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
